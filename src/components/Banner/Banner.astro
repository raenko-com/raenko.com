---
import "./Banner.css";
import { data } from "src/data";
import hero from "src/assets/images/hero.png?url";
---

<section class="banner">
  <div class="banner-content">
    <h1 class="banner-title">{data.title}</h1>
    <p class="banner-description">
      {data.description}
    </p>
    <div class="banner-buttons">
      <a href="#feedback" class="banner-main-action banner-action">Написать</a>
      <a href="#" class="banner-secondary-action banner-action"
        >Смотреть примеры</a
      >
    </div>
  </div>
  <img class="banner-image" src={hero} alt="Banner Image" />
</section>
