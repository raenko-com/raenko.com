---
export interface GuaranteeProps {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="guarantee">
  <img class="guarantee-icon" src={icon} alt={title} />
  <h3 class="guarantee-title">{title}</h3>
  <p class="guarantee-description">{description}</p>
</div>
