---
import "./Process.css";

export interface StageProps {
  number: number;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props as StageProps;
---

<div class:list={["stage-container", { "stage-container-large": number > 2 }]}>
  <div class="stage-header">
    <p class="stage-number">0{number}</p>
    <h3 class="stage-title">{title}</h3>
  </div>
  <p class="stage-description">{description}</p>
</div>
