---
import type { SvgComponent } from "astro/types";
import "./Process.css";

export interface StageProps {
  title: string;
  description: string;
  icon: SvgComponent;
  tag: string;
}

const { title, description, icon: Icon, tag } = Astro.props as StageProps;
---

<div class="stage-container">
  <div class="stage-icon-container">
    <Icon class="stage-icon" />
  </div>
  <div class="stage-info">
    <h3 class="stage-title">{title}</h3>
    <p class="stage-description">{description}</p>
    <span class="stage-tag">{tag}</span>
  </div>
</div>
