---
import "./Team.css";

export interface ColleagueProps {
  name: string;
  role: string;
  photo: string;
  tags: string[];
}

const { name, role, photo, tags } = Astro.props as ColleagueProps;
---

<div class="colleague">
  <img src={photo} alt={name} class="colleague-photo" />
  <div class="colleague-info">
      <h3 class="colleague-name">{name}</h3>
      <p class="colleague-role">{role}</p>
      <div class="colleague-tags">
        {tags.map(tag => (
          <span class="colleague-tag">{tag}</span>
        ))}
      </div>
  </div>
</div>
